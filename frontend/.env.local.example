# Base URL of the Spring Boot backend
NEXT_PUBLIC_API_BASE=http://localhost:8080
# Demo tenant (seed salon). In production this comes from auth instead.
NEXT_PUBLIC_TENANT_ID=11111111-1111-1111-1111-111111111111
# Google Sign-In client id. Leave empty to use the local "demo" Google button
# (backend must run with barbarizoo.google.mode=mock). Set a real OAuth client id
# (and backend GOOGLE_AUTH_MODE=real + GOOGLE_CLIENT_ID) for genuine Google login.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Stripe publishable key. Leave empty for the simulated one-click deposit. Set it
# (and backend PAYMENTS_PROVIDER=stripe + STRIPE_SECRET_KEY) to collect real cards.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
