# Copy to .env and fill in. Used by docker-compose.yml.
# cp .env.example .env

# --- Domains (point both A-records at the VPS IP first) ---
DOMAIN=barbarizoo.de
API_DOMAIN=api.barbarizoo.de

# --- Database ---
DB_USER=barbarizoo
DB_PASSWORD=change-me-to-a-strong-password

# --- Security (generate: openssl rand -base64 48) ---
JWT_SECRET=change-me-to-a-long-random-48char-plus-secret

# --- Optional: Stripe (defaults to simulated payments if unset) ---
PAYMENTS_PROVIDER=simulated
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Optional: Google Sign-In (defaults to mock if unset) ---
GOOGLE_AUTH_MODE=mock
GOOGLE_CLIENT_ID=
